# --- ChronoVault: self-contained test environment (chronovault.sh) ---
# Everything chronovault.sh generates -- test data, databases, archive,
# and every report -- lives inside this one folder. Ignoring the whole
# folder means cleanup and git status both stay simple.
chronovault_test/

# --- ChronoVault: GUI personal settings (not shared, machine-specific) ---
# Your last-used Source/Archive folder paths -- gui_config.json (the
# static, developer-facing tool-location config) IS checked in; this
# is not.
gui/gui_settings.ini

# --- ChronoVault: databases (regenerated by indexer.py / importer.py) ---
*.db
*.sqlite
*.sqlite3

# --- ChronoVault: the archive itself (actual photos/videos, not source-controlled) ---
archive/
test_data/

audit_result.json
duplicate_report.json
condition_report.json


# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/

# -- images ---
*.jpg
*.jpeg
*.png
*.webp

# --- Editor / OS clutter ---
.vscode/
.DS_Store
Thumbs.db
